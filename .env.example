# ==============================================================
# PROFESSIONAL BASIC SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ==============================================================

# Application Security
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key
JWT_ACCESS_TOKEN_HOURS=12

# Database Configuration (MySQL 8.0 or SQLite Fallback)
# Set USE_MYSQL=true to connect to your local or remote MySQL Server
USE_MYSQL=false
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_management_db

# Optional Direct Database Connection String:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/school_management_db

# School Institutional Branding (Ghanaian Basic School Context)
SCHOOL_NAME="Charity Preparatory School"
SCHOOL_MOTTO="Knowledge, Discipline, and Excellence"
SCHOOL_ADDRESS="P.O. Box CP 120, Accra, Ghana"
SCHOOL_PHONE="+233 24 412 3456"
SCHOOL_EMAIL="info@charitypreparatory.edu.gh"
DEFAULT_CURRENCY=GHS
DEFAULT_CURRENCY_SYMBOL=GH₵

# External Notification & SMS Providers (Optional)
# If left empty, system gracefully indicates provider is unconfigured
ARKESEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
